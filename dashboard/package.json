{
	"name": "oak-park-crash-explorer",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "Static explorer of Oak Park, IL traffic crashes: Village police reports (2024–present) and IDOT crash data (2014–)",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"check": "biome check . ../extract && tsc -b",
		"check:fix": "biome check --write . ../extract && tsc -b",
		"test": "vitest run",
		"test:watch": "vitest",
		"data:fetch": "node ../extract/fetch-village.ts && node ../extract/fetch-idot.ts && node ../extract/fetch-osm.ts",
		"data:build": "node ../extract/build.ts",
		"data:refresh": "npm run data:fetch && npm run data:build"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.1.1",
		"@radix-ui/react-popover": "^1.1.6",
		"@radix-ui/react-slot": "^1.1.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"leaflet": "^1.9.4",
		"lucide-react": "^0.469.0",
		"plotly.js-basic-dist-min": "^3.0.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-leaflet": "^5.0.0",
		"react-plotly.js": "^2.6.0",
		"tailwind-merge": "^2.6.0",
		"zustand": "^5.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@tailwindcss/vite": "^4.3.2",
		"@types/leaflet": "^1.9.20",
		"@types/node": "^22.10.0",
		"@types/plotly.js": "^2.35.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/react-plotly.js": "^2.6.3",
		"@vitejs/plugin-react": "^4.3.4",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.2.5",
		"typescript": "^5.7.0",
		"vite": "^6.0.0",
		"vitest": "^3.2.7"
	}
}
